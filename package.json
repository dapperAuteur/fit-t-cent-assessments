{
  "name": "fit-t-cent-assessments",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev -p 3070",
    "build": "next build",
    "start": "next start -p 3070",
    "lint": "eslint && node scripts/check-copy.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:migrate:file": "node --env-file=.env.prod --import tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "1.7.14",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "posthog-js": "^1.444.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.22.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
