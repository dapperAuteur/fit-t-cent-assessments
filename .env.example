# Copy to .env.local for local overrides. NEVER commit .env.local. Claude does not read .env* files.
# Phase 1a builds and runs with every value below empty.

# === App ===
# Canonical origin for metadata. Production: https://assessments.witus.online (BAM, 2026-11-01).
# Empty locally and on previews: Vercel's VERCEL_PROJECT_PRODUCTION_URL, then localhost, are used.
APP_URL=""

# === Analytics: PostHog, marketing pages only (plans user task 07) ===
# Shared ecosystem project key. Empty = analytics off (a supported state: previews, CI, local).
NEXT_PUBLIC_POSTHOG_KEY=""
# The shared project is US. A US key against the EU host fails silently.
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# === Sign in with WitUS + Better Auth (phase 1b) ===
# Locally every value can stay empty: a fixed development secret, http://localhost:3070, and the
# development sign-in (a link printed to the server console) are used. On Vercel the secret is
# required and the development sign-in never exists.
BETTER_AUTH_SECRET=""            # openssl rand -base64 32
# Production: https://assessments.witus.online. Empty = APP_URL, then Vercel's production or
# deployment URL, then localhost (src/lib/runtime-env.ts, resolveBaseUrl).
BETTER_AUTH_URL=""
# Both set = the "Sign in with WitUS" button appears. Either empty = the provider stays off.
# The IdP registers {BETTER_AUTH_URL}/api/auth/oauth2/callback/witus for client slug `assessments`.
WITUS_OIDC_CLIENT_ID=""
WITUS_OIDC_CLIENT_SECRET=""
# Optional override; empty = https://accounts.witus.online/api/idp/.well-known/openid-configuration
WITUS_OIDC_DISCOVERY_URL=""

# === Database: Neon on Vercel, embedded PGlite locally ===
# Empty locally = embedded PGlite under ./.data/pglite, migrated on first use.
# On Vercel the Neon integration sets STORAGE_DATABASE_URL (pooled) and
# STORAGE_DATABASE_URL_UNPOOLED (direct); DATABASE_URL overrides the first when set.
DATABASE_URL=""
# Migrations (pnpm db:migrate) prefer the direct connection.
DATABASE_URL_UNPOOLED=""
